# Get this from https://resend.com/api-keys (never commit the real key)
RESEND_API_KEY=re_xxxxxxxxx

# The "from" address on your verified domain, e.g. hello@wimpy-corp.com.ng
RESEND_FROM_ADDRESS="Wimpy Cooperations <hello@yourdomain.com>"

# Email address that receives a notification when a new inbound message is stored.
INBOUND_NOTIFICATION_EMAIL=

# Embeddable website contact widget.
CONTACT_WIDGET_TO_EMAIL=info@yourdomain.com
# Comma-separated origins allowed to submit the widget, e.g. https://agosoft.com.ng
CONTACT_WIDGET_ALLOWED_ORIGINS=https://agosoft.com.ng

# Optional: comma-separated list of allowed recipient addresses.
# If set, the API will reject any "to" address not in this list.
# Leave blank to allow sending to any address the caller supplies.
ALLOWED_RECIPIENTS=

# --- Inbound email (Cloudflare Email Routing + Worker) ---

# From https://supabase.com project settings - used to store received/sent emails
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Private Supabase Storage bucket for inbound attachments.
SUPABASE_ATTACHMENTS_BUCKET=email-attachments

# Random string only your Cloudflare Worker and this app both know.
# Generate one with: openssl rand -hex 32
INBOUND_SHARED_SECRET=

# Secret used to sign staff login cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=

